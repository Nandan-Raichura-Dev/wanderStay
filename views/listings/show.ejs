<% layout("/layouts/boilerplate") %>

<div class="row">
  <div class="col-8 offset-1">
    <h3 class="mt-3">Listing details</h3>
  </div>

  <div class="col-6 offset-1">
    <div class="card">
      <img src="<%=listing.image.url%>" class="card-img-top show-image" alt="listing_image">
      <div class="card-body">
        <br>
        <h4 class="card-title"><%= listing.title %></h4>
        <p class="card-text">
          <%= listing.description %><br>
          &#8377;<%= listing.price != null ? listing.price.toLocaleString("en-IN") : "N/A" %><br>
          <%= listing.location %><br>
          <%= listing.country %>
        </p>
      </div>
    </div>

    <div class="btns">
      <a href="/listings/<%=listing._id%>/edit" class="btn btn-dark" class="edit-btns">Edit</a>

      <form method="POST" action="/listings/<%=listing._id%>?_method=DELETE">
        <button class="btn btn-dark">Delete</button>
      </form>
    </div>
  </div>
</div>