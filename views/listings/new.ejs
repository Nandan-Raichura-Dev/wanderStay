
<% layout("/layouts/boilerplate") %>

    <div class="row">
    <div class="col-8 offset-2">

    <h2> Create New List</h2>
    <form method="POST" action="/listings">
        <div class="mb-3">
        <lable for="title" class="form-label">Title</lable>
        <input 
        name="listing[title]" 
        placeholder="enter title" 
        type="text" 
        class="form-control">
        </div>

        <div class="mb-3">

         <lable for="description" class="form-label">Description</lable>
         <textarea 
         name="listing[description]" 
         placeholder="enter description"
         class="form-control">
        </textarea>

        </div>

        <div class="mb-3">
        <lable for="image" class="form-label">Image-Link</lable>
        <input 
        name="listing[image]" 
        placeholder="enter image url" 
        type="text"
        class="form-control"
        >

        </div>

        <div class="mb-3">
      <lable for="price" class="form-label">Price</lable>
 
        <input 
        name="listing[price]" 
        placeholder="enter price"
         type="number"
         class="form-control"
         
         >

        </div>

        <div class="mb-3">
             <lable for="country" class="form-label">country</lable>
              <input 
              name="listing[country]" 
              placeholder="enter country" 
              type="text"
                class="form-control">
        </div>

       
       <div class="mb-3">
          <lable for="location" class="form-label">location</lable>
        <input 
        name="listing[location]" 
        placeholder="enter location" 
        type="text"
        class="form-control"
        >

       </div>

        
      
     

      
       
  

        <button class="btn btn-dark">submit</button>
       </form>
    </div>
    </div>