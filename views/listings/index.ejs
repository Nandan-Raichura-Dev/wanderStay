<% layout("/layouts/boilerplate") %>
<body>
      <h3>All Listings</h3>
        <!-- <form method="GET" action="/listings/new">
            <button>newList</button>
        </form> -->

        <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1">
            
        <% for(let listings of allListings){%>
          <a href="/listings/<%=listings._id%>" class="listing-link">
        <section class="card col" >
  <img 
  src="<%=listings.image.url%>" 
  class="card-img-top" alt="Listings Image" 
  style="height: 21rem;"
  />
  <div class="card-img-overlay"></div>

  <div class="card-body">
    <h4 class="card-title"><b><%=listings.title%></b></h4>
   
    <p class="card-text"></p>
  &#8377; <%= listings.price != null ? listings.price.toLocaleString("en-IN") : "N/A" %> /night
    
  </div>
</section>
   </a>
  <% } %>

        </div>

     


    
    



    